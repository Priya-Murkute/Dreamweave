# Leave both unset and the app falls back to the offline demo generator.

# 1. Hosted model. Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Local model. No account: install Ollama, then `ollama pull llama3.2`.
#    OLLAMA_HOST defaults to http://127.0.0.1:11434
OLLAMA_MODEL=
# OLLAMA_HOST=

# Inlined at BUILD time, not read at runtime — set this to the deployed origin
# before building, or every share link will point at localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Sharing. Without these, /api/story answers 503 and the rest of the app
#    still works. Free Redis, no card: https://upstash.com — create a database,
#    open its REST API section, and copy the two values across.
#    Upstash calls them UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN;
#    @vercel/kv reads the KV_ names below, so rename them when you paste.
KV_REST_API_URL=
KV_REST_API_TOKEN=
